<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.omnixys</groupId>
    <artifactId>bom</artifactId>
    <version>1.0.4</version>
    <packaging>pom</packaging>

    <name>Omnixys BOM</name>
    <description>Central dependency management for Omnixys ecosystem</description>
    <url>https://github.com/omnixys/omnixys-bom</url>

    <licenses>
        <license>
            <name>GPL-3.0-or-later</name>
            <url>https://www.gnu.org/licenses/gpl-3.0-standalone.html</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>caleb-gyamfi</id>
            <name>Caleb Gyamfi</name>
            <email>caleb.gyamfi@omnixys.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/omnixys/omnixys-bom.git</connection>
        <developerConnection>scm:git:ssh://github.com:omnixys/omnixys-bom.git</developerConnection>
        <url>https://github.com/omnixys/omnixys-bom</url>
    </scm>

    <properties>
        <java.version>26</java.version>
        <maven.compiler.release>26</maven.compiler.release>
        <spring.boot.version>4.1.0</spring.boot.version>

        <omnixys.commons.version>1.0.4</omnixys.commons.version>
        <omnixys.context.version>1.0.2</omnixys.context.version>

        <omnixys.cache.version>1.0.3</omnixys.cache.version>
        <omnixys.storage.version>1.0.2</omnixys.storage.version>
        <omnixys.validation.version>1.0.2</omnixys.validation.version>
        <omnixys.observability.version>1.1.3</omnixys.observability.version>

        <omnixys.logger.version>1.0.4</omnixys.logger.version>
        <omnixys.kafka.version>1.0.4</omnixys.kafka.version>
        <omnixys.security-starter.version>2.0.0</omnixys.security-starter.version>

        <omnixys.starter.version>1.0.2</omnixys.starter.version>
        <omnixys.test-common.version>1.0.0</omnixys.test-common.version>

        
        
    </properties>

    <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/omnixys/omnixys-bom</url>
        </repository>
    </distributionManagement>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM manages OTel, Micrometer, Jackson, Lombok, etc. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Omnixys packages -->
            <dependency>
                <groupId>com.omnixys</groupId>
                <artifactId>commons</artifactId>
                <version>${omnixys.commons.version}</version>
            </dependency>

            <dependency>
                <groupId>com.omnixys</groupId>
                <artifactId>starter</artifactId>
                <version>${omnixys.starter.version}</version>
            </dependency>

            <dependency>
                <groupId>com.omnixys</groupId>
                <artifactId>observability</artifactId>
                <version>${omnixys.observability.version}</version>
            </dependency>

            <dependency>
                <groupId>com.omnixys</groupId>
                <artifactId>kafka</artifactId>
                <version>${omnixys.kafka.version}</version>
            </dependency>

            <dependency>
                <groupId>com.omnixys</groupId>
                <artifactId>logger</artifactId>
                <version>${omnixys.logger.version}</version>
            </dependency>

            <dependency>
                <groupId>com.omnixys</groupId>
                <artifactId>security-starter</artifactId>
                <version>${omnixys.security-starter.version}</version>
            </dependency>

            <dependency>
                <groupId>com.omnixys</groupId>
                <artifactId>test-common</artifactId>
                <version>${omnixys.test-common.version}</version>
            </dependency>

            <dependency>
                <groupId>com.omnixys</groupId>
                <artifactId>context</artifactId>
                <version>${omnixys.context.version}</version>
            </dependency>

            <dependency>
                <groupId>com.omnixys</groupId>
                <artifactId>validation</artifactId>
                <version>${omnixys.validation.version}</version>
            </dependency>

            <dependency>
                <groupId>com.omnixys</groupId>
                <artifactId>cache</artifactId>
                <version>${omnixys.cache.version}</version>
            </dependency>

            <dependency>
                <groupId>com.omnixys</groupId>
                <artifactId>storage</artifactId>
                <version>${omnixys.storage.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
